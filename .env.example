# Clé lue directement par le provider OpenAI de Pydantic AI.
OPENAI_API_KEY=sk-...

# Configuration de l'agent.
TIA_MODEL=openai-responses:gpt-5.6-luna
TIA_WORKSPACE=.
TIA_SETUP_FILE=agent.setup.yaml
TIA_INSTRUCTIONS_FILE=AGENTS.md
TIA_MAX_INSTRUCTIONS_CHARS=65536
TIA_COMMAND_TIMEOUT_SECONDS=30
TIA_MAX_OUTPUT_CHARS=12000
